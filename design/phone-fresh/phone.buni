  "rules": {},
  "sections": {
    "141780b8": {
      "body": "An inbox, work, machines: three tabs, as the GitHub app has. Signals are the inbox, each a card with its context and its actions. A worktree is a page like a pull request: state, numbers, tabs for its terminal, changes and log. The terminal is Rex-like: full screen, windows as a strip, a command palette. Dark by default; mono for data, sans for sentences; one accent per state.",
      "heading": "Direction",
      "id": "141780b8",
      "index": "a1"
    },
    "dd3897e6": {
      "body": "A developer whose coding agents work in mia worktrees on their own machines. On the phone: see what needs them, answer by opening the terminal, steer, start the next thing, and put the phone away.",
      "heading": "Who it is for",
      "id": "dd3897e6",
      "index": "a0"
    }
  },
