          "ref": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "listening": {
        "type": "array",
        "optional": true,
        "items": {
          "type": "integer"
        }
      },
      "machine": {
        "type": "string"
      },
      "mirror": {
        "type": "string",
        "optional": true
      },
      "name": {
        "type": "string"
      },
      "placement": {
        "type": "opaque",
        "go": "model.Placement"
      },
      "ports": {
        "type": "object",
        "fields": {
          "declared": {
            "type": "array",
            "optional": true,
