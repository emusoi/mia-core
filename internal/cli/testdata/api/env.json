              "type": "string",
              "optional": true
            },
            "healthy": {
              "type": "boolean",
              "optional": true,
              "nullable": true
            },
            "id": {
              "type": "string"
            },
            "run": {
              "type": "array",
              "optional": true,
              "items": {
                "type": "string"
              }
            },
            "running": {
              "type": "boolean"
            }
          }
        }
