{
  "query": "main",
  "usage": "mia api main [conversations|turns [--conversation \u003cid\u003e] [--after \u003cn\u003e] [--follow]]",
  "inputs": [
    {
      "name": "conversations"
    },
    {
      "name": "turns"
    },
    {
      "name": "--conversation",
      "value": "\u003cid\u003e"
    },
    {
      "name": "--after",
      "value": "\u003cn\u003e"
    },
    {
      "name": "--follow"
    }
  ],
  "output": {
    "type": "object",
    "fields": {
      "account": {
        "type": "string",
        "optional": true
      },
      "agent": {
        "type": "string"
      },
      "asks": {
        "type": "object",
        "optional": true,
        "nullable": true,
        "fields": {
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selected": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "conversation": {
        "type": "string"
      },
      "effort": {
        "type": "string",
        "optional": true
      },
      "home": {
        "type": "string"
      },
      "machine": {
        "type": "string"
      },
      "model": {
        "type": "string",
        "optional": true
      },
      "name": {
        "type": "string"
      },
      "running": {
        "type": "boolean"
      },
      "session": {
        "type": "string"
      },
      "since": {
        "type": "time",
        "optional": true
      },
      "window": {
        "type": "object",
        "optional": true,
        "nullable": true,
        "fields": {
          "index": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "working": {
        "type": "boolean"
      }
    }
  }
