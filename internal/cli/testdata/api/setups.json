{
  "query": "setups",
  "usage": "mia api setups [--repository \u003cname\u003e | --all]",
  "inputs": [
    {
      "name": "--repository",
      "value": "\u003cname\u003e"
    },
    {
      "name": "--all"
    }
  ],
  "output": {
    "type": "array",
    "items": {
      "type": "object",
      "fields": {
        "account": {
          "type": "string",
          "optional": true
        },
        "agent": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "optional": true
        },
        "effort": {
          "type": "string"
        },
        "last": {
          "type": "object",
          "optional": true,
          "nullable": true,
          "fields": {
            "at": {
              "type": "time"
            },
            "machine": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "worktree": {
              "type": "string"
            }
          }
        },
        "model": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "optional": true
        },
        "sessions": {
          "type": "integer"
        },
        "uses": {
          "type": "integer"
        },
        "usual": {
          "type": "boolean"
        }
      }
    }
  }
}
